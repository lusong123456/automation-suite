# automation-suite 环境配置示例
# 复制为 .env 并按需修改

# 被测系统基础地址（IoT 平台根前缀，登录路径 /auth/login 由 AuthManager 拼接）
BASE_URL=http://<IoT_HOST>/prod-api

# 登录账号与密码（按实际测试账号填写，.env 不入库）
USERNAME=
PASSWORD=

# 环境标识：dev / test / staging
ENV=test

# 请求超时秒数
REQUEST_TIMEOUT=30

# 网络错误重试配置
MAX_RETRIES=3
RETRY_BASE_DELAY=1
RETRY_MAX_DELAY=10

# ---- MQTT 配置（可选，不使用 MQTT 可忽略） ----
MQTT_BROKER_HOST=broker.emqx.io
MQTT_BROKER_PORT=1883
MQTT_BROKER_USERNAME=
MQTT_BROKER_PASSWORD=
MQTT_CLIENT_ID=automation-suite-01
MQTT_KEEPALIVE=60
MQTT_DEFAULT_QOS=1
MQTT_CONNECT_TIMEOUT=10

# ---- IoT 平台契约测试配置 ----
# 账号密码与 USERNAME 一并填入 .env（.env 已被 .gitignore 排除，不入库）

# APIFOX 项目 ID（Trae 调 MCP 拉 OpenAPI spec 用，从 APIFOX 客户端复制）
APIFOX_PROJECT_ID=

# 测试场所 ID（可选；仅写副作用链路需要做隔离，读用例不要求）
TEST_SCENE_ID=

# 测试租户 ID（可选，多租户隔离用；不填则只用 TEST_SCENE_ID）
TEST_TENANT_ID=

# ---- RuoYi-Cloud-Plus 混合加密登录配置 ----
# 默认值已写在 common/config.py（agent 扒自前端 user-CD10iO_L.js）；
# 此处显式列出便于覆盖（如更换前端版本后改公钥 / clientid）
LOGIN_RSA_PUBKEY=MFwwDQYJKoZIhvcNAQEBBQADSwAwSAJBAKoR8mX0rGKLqzcWmOzbfj64K8ZIgOdHnzkXSOVOZbFu/TJhZ7rFAN+eaGkl3C4buccQd/EjEsj9ir7ijT7h96MCAwEAAQ==
LOGIN_CLIENTID=e5cd7e4891bf95d1d19206ce24a7b32e

# APIFOX access_token（敏感，不在此填入；通过 MCP 配置的 env 字段注入）
# 参考配置位置：~/.trae-cn/mcp_config.json 中 apifox server 的 env.APIFOX_ACCESS_TOKEN
