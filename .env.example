# automation-suite 环境配置示例
# 复制为 .env 并按需修改

# 被测系统基础地址（示例使用 reqres.in）
BASE_URL=https://reqres.in

# 登录账号（reqres 提供的公开测试账号）
USERNAME=eve.holt@reqres.in
PASSWORD=cityslicka

# 环境标识：dev / test / staging
ENV=dev

# 请求超时秒数
REQUEST_TIMEOUT=30

# 网络错误重试配置
MAX_RETRIES=3
RETRY_BASE_DELAY=1
RETRY_MAX_DELAY=10

# ---- MQTT 配置（可选，不使用 MQTT 可忽略） ----
MQTT_BROKER_HOST=broker.emqx.io
MQTT_BROKER_PORT=1883
MQTT_BROKER_USERNAME=
MQTT_BROKER_PASSWORD=
MQTT_CLIENT_ID=automation-suite-01
MQTT_KEEPALIVE=60
MQTT_DEFAULT_QOS=1
MQTT_CONNECT_TIMEOUT=10
