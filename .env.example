# automation-suite 环境配置示例
# 复制为 .env 并按需修改

# 被测系统基础地址（示例使用 reqres.in）
BASE_URL=https://reqres.in

# 登录账号（reqres 提供的公开测试账号）
USERNAME=eve.holt@reqres.in
PASSWORD=cityslicka

# 环境标识：dev / test / staging
ENV=dev

# 请求超时秒数
REQUEST_TIMEOUT=30

# 网络错误重试配置
MAX_RETRIES=3
RETRY_BASE_DELAY=1
RETRY_MAX_DELAY=10
